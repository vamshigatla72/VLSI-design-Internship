module tb_register4;
    reg clk;
    reg [3:0] D;
    wire [3:0] Q;

    // Instantiate Unit Under Test
    register4 uut (
        .clk(clk),
        .D(D),
        .Q(Q)
    );

    // Clock Generation
    always #5 clk = ~clk;

    initial begin
        // GTKWave Configuration
        $dumpfile("dump.vcd");
        $dumpvars(0, tb_register4);

        // Initialize inputs
        clk = 0;
        D = 4'b0000;

        // Stimulus
        #10 D = 4'b1010;
        #10 D = 4'b0110;
        #10 D = 4'b1111;
        #10 D = 4'b0000;
        #10 $finish;
    end
endmodule
