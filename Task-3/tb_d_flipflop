module tb_d_flipflop;
    // Inputs
    reg clk;
    reg D;
    
    // Outputs
    wire Q;

    // Instantiate the Unit Under Test (UUT)
    d_flipflop uut (
        .clk(clk),
        .D(D),
        .Q(Q)
    );

    // Clock generation 
    always #5 clk = ~clk;

    initial begin
        $dumpfile("dump.vcd"); 
        $dumpvars(0, tb_d_flipflop); 

        // Initialize inputs
        clk = 0;
        D = 0;    
        #10 D = 1;
        #10 D = 0;
        #10 D = 1;
        #20 $finish; 
    end
endmodule
